# ── Sentinel configuration ──────────────────────────────────────────────────
# Copy to .env and adjust. Never commit .env.

# ── Core ──────────────────────────────────────────────────────────────────
# Postgres (use db/redis hostnames inside docker compose)
DATABASE_URL=postgresql+psycopg2://sentinel:sentinel@db:5432/sentinel
REDIS_URL=redis://redis:6379/0
POSTGRES_USER=sentinel
POSTGRES_PASSWORD=sentinel
POSTGRES_DB=sentinel

# ── Security ──────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=generate-a-64-hex-char-secret
SESSION_TTL_DAYS=14
# Set to 1 when serving the API over HTTPS behind a proxy
COOKIE_SECURE=0
# Comma-separated list of allowed browser origins for the API
CORS_ORIGINS=http://localhost:3000

# ── Email (SMTP) ──────────────────────────────────────────────────────────
# Defaults point at the bundled Mailpit dev inbox (UI at http://localhost:8025)
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=sentinel@sentinel.local
SMTP_TLS=0

# ── Scanner knobs ─────────────────────────────────────────────────────────
SCANNER_USER_AGENT=SentinelSecurityScanner/1.0.0
SCAN_TIMEOUT=60
SCAN_CONNECT_TIMEOUT=10
SCAN_READ_TIMEOUT=30
SCAN_MAX_REDIRECTS=8
SCAN_MAX_RESPONSE_SIZE=2097152
SCAN_RATE_LIMIT=5.0
SCAN_CONCURRENCY=4
# SECURITY: enable ONLY for local lab testing against authorized private
# containers (tests/labs). Never enable when scanning internet targets.
SCAN_ALLOW_PRIVATE_TARGETS=0

# ── Stuck-scan sweeper (beat task, 60s cadence) ───────────────────────────
# QUEUED scans are failed after STALE_SECONDS by created_at; SCANNING/
# ANALYZING scans by started_at. 900s default = SAFE (SCAN_TIMEOUT is 60s,
# a healthy scan never trips it). Set STUCK_SCANS_ENABLED=0 to disable.
STUCK_SCANS_ENABLED=1
STUCK_SCANS_STALE_SECONDS=900

# ── API discovery ─────────────────────────────────────────────────────────
# How the WEB APP reaches the API for proxied /api/* calls.
#   Docker Compose stack:  http://api:8000        (container-to-container)
#   Local-dev (§4 guide):  http://localhost:8000  (Next dev runs on the host)
# Leave this UNSET for the compose stack — docker-compose.yml defaults it to
# http://api:8000. Only LOCAL-DEV needs the localhost value set here.
# NEXT_PUBLIC_API_URL=
